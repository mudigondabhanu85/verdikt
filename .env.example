# Copy to backend/.env for local dev. Every variable here maps directly
# to a field in backend/app/config.py — see that file for the fuller
# rationale behind each default.

# Postgres (default; run `docker compose up -d db`)
DATABASE_URL=postgresql+psycopg://verdikt:verdikt@localhost:5432/verdikt

# The frontend's own origin — needed for CORS (backend/app/main.py).
# Must match wherever the frontend is actually served from.
FRONTEND_ORIGIN=http://localhost:5173

JWT_SECRET=dev-only-change-me-to-something-random-and-32-bytes-plus
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Dev-only Fernet key for LocalKMSAdapter. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Production MUST swap in a real KMSAdapter (AWS KMS / Azure Key Vault) — see
# backend/app/vault/kms_adapter.py.
VAULT_MASTER_KEY=dev-only-insecure-fernet-key-000000000000=

# "local" (default) needs nothing else below. "aws" requires
# AWS_KMS_KEY_ID and real AWS credentials available to the process
# (standard boto3 credential resolution — not a Verdikt-specific setting).
KMS_PROVIDER=local
AWS_KMS_KEY_ID=

OBJECT_STORAGE_ROOT=./data/objects

# "local" (default, LocalDiskObjectStorage) needs nothing else below.
# "s3" requires AWS_S3_BUCKET and real AWS credentials available to the
# process.
OBJECT_STORAGE_PROVIDER=local
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# "fake" (default) runs LLM-dependent agents (injection/xss/access-control
# triage) against a no-op adapter that finds nothing, so a fresh checkout
# with no API keys still runs end to end. Set to "claude" or "openai" +
# the matching key below for real AI-assisted reasoning.
AI_PROVIDER=fake
AI_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Per-scan-run cap on estimated LLM spend (USD). Once exceeded, remaining
# LLM-dependent agent nodes are skipped (recorded on their AgentJob), not
# silently truncated.
MAX_LLM_COST_USD_PER_SCAN=2.00

# Hostname/IP the *target* can route back to, for the SSRF agent's
# out-of-band callback proof. Only relevant when actually running scans
# against a target that could plausibly call back to this scanner (same
# Docker network, same LAN, or a scanner with a public hostname) — leave
# unset to fall back to best-effort auto-detection of the local machine's
# own address.
SSRF_CALLBACK_HOST=
