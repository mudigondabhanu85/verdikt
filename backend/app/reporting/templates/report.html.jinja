<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Verdikt Security Assessment Report</title>
<style>
  body { font-family: -apple-system, Segoe UI, Helvetica, Arial, sans-serif; max-width: 900px; margin: 2rem auto; padding: 0 1rem; color: #1a1a1a; line-height: 1.5; }
  h1 { font-size: 1.6rem; }
  h2 { font-size: 1.25rem; border-bottom: 1px solid #ddd; padding-bottom: .25rem; margin-top: 2.5rem; }
  .legend { display: flex; gap: .75rem; flex-wrap: wrap; margin: 1rem 0; }
  .badge { display: inline-block; padding: .15rem .6rem; border-radius: 999px; font-size: .8rem; font-weight: 600; color: #fff; }
  .badge.Critical { background: #7f1d1d; }
  .badge.High { background: #b91c1c; }
  .badge.Medium { background: #b45309; }
  .badge.Low { background: #2563eb; }
  .summary-table { border-collapse: collapse; margin: 1rem 0; }
  .summary-table td, .summary-table th { border: 1px solid #ddd; padding: .4rem .8rem; text-align: left; }
  .finding { border: 1px solid #ddd; border-radius: 8px; padding: 1rem 1.25rem; margin: 1.25rem 0; }
  .finding h3 { margin-top: 0; }
  .instance-count { font-weight: 400; font-size: .8rem; color: #555; margin-left: .5rem; }
  .meta { font-size: .85rem; color: #555; margin-bottom: .75rem; }
  .meta span { margin-right: 1rem; }
  .section-label { font-weight: 600; margin-top: .9rem; margin-bottom: .25rem; }
  .instance { border-top: 1px solid #eee; padding-top: .75rem; margin-top: .75rem; }
  .instance summary { cursor: pointer; font-weight: 600; }
  .instance summary code { font-weight: 400; }
  pre { background: #f5f5f5; padding: .75rem; border-radius: 6px; overflow-x: auto; font-size: .8rem; white-space: pre-wrap; word-break: break-word; }
  .glossary dt { font-weight: 600; margin-top: .5rem; }
  .no-findings { color: #555; font-style: italic; }
  .no-visual-poc { color: #555; font-style: italic; font-size: .9rem; }
  .screenshot { max-width: 100%; border: 1px solid #ddd; border-radius: 6px; margin-top: .5rem; display: block; }
  mark { background: #fde047; color: #1c1917; padding: 0 .15rem; border-radius: 2px; }
  a { color: {{ branding.primary_color_hex if branding and branding.primary_color_hex else '#1d4ed8' }}; }
  .report-logo { max-height: 64px; margin-bottom: 1rem; display: block; }
  .command { border-top: 1px solid #eee; padding: .75rem 0; }
  .command .command-head { display: flex; align-items: baseline; gap: .5rem; font-size: .85rem; color: #555; }
  .command .command-head .seq { font-weight: 600; color: #1a1a1a; }
  .command .command-head .tool { background: #eef2ff; color: #3730a3; border-radius: 4px; padding: 0 .4rem; font-size: .75rem; }
  .command .command-head .exit-ok { color: #15803d; }
  .command .command-head .exit-err { color: #b91c1c; }
  .command code.cmd { display: block; font-size: .8rem; background: #f5f5f5; padding: .5rem .75rem; border-radius: 6px; margin-top: .35rem; overflow-x: auto; white-space: pre-wrap; word-break: break-word; }
  .command .rationale { font-style: italic; color: #444; font-size: .85rem; margin-top: .35rem; }
  .command details { margin-top: .35rem; }
  .command summary { cursor: pointer; font-size: .8rem; color: #555; }
</style>
</head>
<body>

{% if branding and branding.logo_data_uri %}
<img class="report-logo" src="{{ branding.logo_data_uri }}" alt="{{ branding.company_name or 'Company logo' }}">
{% endif %}
<h1>{{ (branding.company_name + ' — ') if branding and branding.company_name else '' }}Verdikt Security Assessment Report</h1>
<p>Scan run <code>{{ scan_run.id }}</code> — status: <strong>{{ scan_run.status }}</strong></p>

<h2>How to read this report</h2>
<p>
  Findings are ranked by severity. <strong>Critical</strong> and <strong>High</strong> findings
  represent the most pressing risk and should be addressed first;
  <strong>Medium</strong> and <strong>Low</strong> findings still matter and are included in full —
  they are not noise. Every finding listed here has been automatically re-confirmed with an
  independent, reproducible check before being included; nothing in this report is a raw,
  unverified scanner guess.
</p>
<div class="legend">
  <span class="badge Critical">Critical</span>
  <span class="badge High">High</span>
  <span class="badge Medium">Medium</span>
  <span class="badge Low">Low</span>
</div>
<dl class="glossary">
  <dt>OWASP Top 10:2025 category</dt>
  <dd>Which broad class of web application risk this finding falls under.</dd>
  <dt>CWE</dt>
  <dd>Common Weakness Enumeration — a standard identifier for the underlying software weakness.</dd>
  <dt>CVSS</dt>
  <dd>Common Vulnerability Scoring System — the 0–10 score behind the severity rating.</dd>
</dl>

{% if executive_summary %}
<h2>Executive Summary</h2>
<p>{{ executive_summary }}</p>
{% endif %}

<h2>Summary</h2>
<table class="summary-table">
  <tr><th>Severity</th><th>Count</th></tr>
  {% for sev in ["Critical", "High", "Medium", "Low"] %}
  <tr><td><span class="badge {{ sev }}">{{ sev }}</span></td><td>{{ scan_run.finding_counts_by_severity.get(sev, 0) }}</td></tr>
  {% endfor %}
</table>

{% if attack_chains %}
<h2>Attack Chains</h2>
<p>
  These findings, individually Confirmed above and below, combine into a worse compound
  exploit — a real attacker chaining them together achieves more than any single finding
  suggests. Each chain listed here has independently passed the same Confirmed-Only
  adversarial-validation discipline as every other finding in this report.
</p>
{% for c in attack_chains %}
<div class="finding">
  <h3><span class="badge {{ c.severity }}">{{ c.severity }}</span> {{ c.title }}</h3>
  <div class="meta"><span>Links {{ c.finding_ids|length }} findings</span></div>
  <div class="section-label">What this means</div>
  <p>{{ c.plain_language_summary }}</p>
  <div class="section-label">Narrative</div>
  <p>{{ c.narrative }}</p>
  {% if c.steps_to_reproduce %}
  <div class="section-label">Steps to reproduce (end-to-end)</div>
  <ol>{% for step in c.steps_to_reproduce %}<li>{{ step }}</li>{% endfor %}</ol>
  {% endif %}
</div>
{% endfor %}
{% endif %}

{% if pentest_commands %}
<h2>Pentest Transcript</h2>
<p>
  This scan run used Verdikt's AI-driven autonomous pentest mode: rather than a fixed set of
  deterministic checks, an AI agent decided turn by turn what to investigate and ran real
  commands (shell access, real network requests) inside an isolated, network-restricted sandbox.
  Every command it ran is recorded below, in order, alongside the reasoning it gave for running
  it — the same chain-of-custody evidence behind any finding this report concludes with.
</p>
{% for cmd in pentest_commands %}
<div class="command">
  <div class="command-head">
    <span class="seq">#{{ cmd.sequence_number }}</span>
    <span class="tool">{{ cmd.tool_name }}</span>
    {% if cmd.exit_code is not none %}
    <span class="{{ 'exit-ok' if cmd.exit_code == 0 else 'exit-err' }}">exit {{ cmd.exit_code }}</span>
    {% endif %}
  </div>
  <code class="cmd">{{ cmd.command }}</code>
  {% if cmd.model_rationale %}
  <div class="rationale">{{ cmd.model_rationale }}</div>
  {% endif %}
  {% if cmd.stdout or cmd.stderr %}
  <details>
    <summary>Show output</summary>
    {% if cmd.stdout %}<pre>{{ cmd.stdout }}</pre>{% endif %}
    {% if cmd.stderr %}<pre>{{ cmd.stderr }}</pre>{% endif %}
  </details>
  {% endif %}
</div>
{% endfor %}
{% endif %}

<h2>Findings</h2>
{% if finding_groups|length == 0 %}
<p class="no-findings">No confirmed findings for this scan run.</p>
{% else %}
<p>{{ total_finding_count }} confirmed finding{{ '' if total_finding_count == 1 else 's' }} across {{ finding_groups|length }} vulnerability type{{ '' if finding_groups|length == 1 else 's' }}.</p>
{% endif %}
{% for g in finding_groups %}
{% set f = g.shared %}
<div class="finding">
  <h3>
    <span class="badge {{ g.severity }}">{{ g.severity }}</span> {{ g.title }}
    <span class="instance-count">× {{ g.instances|length }} instance{{ '' if g.instances|length == 1 else 's' }}</span>
  </h3>
  <div class="meta">
    <span>{{ f.owasp_2025_category }}</span>
    <span>{{ f.cwe_id }}</span>
  </div>

  <div class="section-label">What this means</div>
  <p>{{ f.plain_language_summary }}</p>

  <div class="section-label">Technical detail</div>
  <p>{{ f.technical_description }}</p>

  <div class="section-label">Remediation</div>
  <p>{{ f.remediation }}</p>

  {% if f.references %}
  <div class="section-label">References</div>
  <ul>
    {% for ref in f.references %}
    <li><a href="{{ ref }}">{{ ref }}</a></li>
    {% endfor %}
  </ul>
  {% endif %}

  <div class="section-label">Instances</div>
  {% for inst in g.detailed_instances %}
  <details class="instance" {{ 'open' if g.instances|length == 1 else '' }}>
    <summary>{{ loop.index }}. <code>{{ inst.affected_endpoints[0] if inst.affected_endpoints else '(no endpoint recorded)' }}</code> — CVSS {{ inst.cvss_score }} ({{ inst.cvss_vector }})</summary>

    <div class="section-label">Affected endpoint(s)</div>
    <ul>
      {% for endpoint in inst.affected_endpoints %}
      <li><code>{{ endpoint }}</code></li>
      {% endfor %}
    </ul>

    <div class="section-label">Steps to reproduce</div>
    <ol>
      {% for step in inst.steps_to_reproduce %}
      <li>{{ step }}</li>
      {% endfor %}
    </ol>

    {% if inst.evidence %}
    <div class="section-label">Evidence — request</div>
    <pre>{{ inst.evidence.request_raw | highlight_payload(inst.evidence.payload) }}</pre>
    <div class="section-label">Evidence — response</div>
    <pre>{{ inst.evidence.response_raw | highlight_payload(inst.evidence.payload) }}</pre>
    {% endif %}

    {% if screenshots_by_finding_id.get(inst.id) %}
    <div class="section-label">Evidence — screenshot</div>
    {% for image_b64 in screenshots_by_finding_id[inst.id] %}
    <img class="screenshot" src="data:image/png;base64,{{ image_b64 }}" alt="Evidence screenshot for {{ g.title }}">
    {% endfor %}
    {% else %}
    <p class="no-visual-poc">No visual proof-of-concept for this finding — it's based on HTTP
      headers/protocol behavior with nothing meaningful to render as a screenshot; see the
      request/response evidence above instead.</p>
    {% endif %}
  </details>
  {% endfor %}
  {% if g.summary_only_instances %}
  <p>Also confirmed at {{ g.summary_only_instances|length }} more endpoint{{ '' if g.summary_only_instances|length == 1 else 's' }} (full evidence shown above is representative and applies identically):</p>
  <ul>
    {% for inst in g.summary_only_instances %}
    <li><code>{{ inst.affected_endpoints[0] if inst.affected_endpoints else '(no endpoint recorded)' }}</code></li>
    {% endfor %}
  </ul>
  {% endif %}
</div>
{% endfor %}

</body>
</html>
